{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clearcopy",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "SHARES", "class_name": "Share" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Share"] }],
  "ratelimits": [
    { "name": "SHARE_LIMIT", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
